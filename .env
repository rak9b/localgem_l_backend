# ================================
# APPLICATION ENVIRONMENT
# ================================
NODE_ENV=production

# ================================
# SERVER CONFIGURATION
# ================================
PORT=5000
FRONTEND_URL=https://localgem-l-frontend.vercel.app
API_VERSION=v1

# ================================
# DATABASE CONFIGURATION
# ================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/localgems?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ================================
# AUTHENTICATION & SECURITY
# ================================
JWT_SECRET=lg_prod_9f2k8a1j3h7g6f5d4s3a2q1w0e9r8t7y6u5i4o3p2m1n0b9v8c7x6z5p4o3i2u1y
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
CORS_ORIGINS=https://localgem-l-frontend.vercel.app

# ================================
# PAYMENT GATEWAY (STRIPE)
# ================================
STRIPE_SECRET_KEY=sk_test_51ABC123...
STRIPE_PUBLISHABLE_KEY=pk_test_51ABC123...
STRIPE_WEBHOOK_SECRET=whsec_ABC123...

# ================================
# EMAIL SERVICE
# ================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=LocalGems <noreply@localgems.com>

# ================================
# LOGGING & MONITORING
# ================================
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/app.log

# ================================
# RATE LIMITING
# ================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ================================
# DEVELOPMENT TOOLS
# ================================
ENABLE_SWAGGER=true
ENABLE_DEBUG_LOGS=true
AUTO_SEED_DATABASE=false
